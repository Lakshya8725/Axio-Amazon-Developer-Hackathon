# Leave unset to use the Next.js proxy at /axio-api, which forwards to the backend.
# Set this only if the browser should call FastAPI directly.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-side proxy target used by next.config.ts. Default is port 8000.
# API_PROXY_TARGET=http://127.0.0.1:8000
